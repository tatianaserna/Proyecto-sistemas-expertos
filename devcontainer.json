{
  "name": "Sistema experto agrícola",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "pip install -r requirements.txt jupyter ipykernel",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Streamlit", "onAutoForward": "openBrowser" } },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter"] }
  }
}
